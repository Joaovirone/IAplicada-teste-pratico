      "id": "d86d5523-fad8-4cff-bc6a-4e595d5d9045",
      "name": "Todo Dia às 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH limites AS (\n  SELECT (now() AT TIME ZONE 'America/Maceio')::date + 1 AS dia\n)\nSELECT\n  p.id AS pedido_id,\n  c.nome AS cliente_nome,\n  c.endereco AS cliente_endereco,\n  COALESCE(t.nome, 'Técnico não definido') AS tecnico_nome,\n  to_char(p.data_instalacao AT TIME ZONE 'America/Maceio', 'DD/MM/YYYY') AS data,\n  to_char(p.data_instalacao AT TIME ZONE 'America/Maceio', 'HH24:MI') AS horario\nFROM public.pedidos p\nJOIN public.clientes c ON c.id = p.cliente_id\nLEFT JOIN public.tecnicos t ON t.id = p.tecnico_id\nCROSS JOIN limites l\nWHERE p.status = 'agendado'\n  AND p.data_instalacao >= (l.dia::timestamp AT TIME ZONE 'America/Maceio')\n  AND p.data_instalacao < ((l.dia + 1)::timestamp AT TIME ZONE 'America/Maceio')\nORDER BY p.data_instalacao, t.nome;",
        "options": {}
      },
      "id": "7971ba6f-3bef-4f6f-ade1-99f09e9ea875",
      "name": "Buscar Instalações de Amanhã",
